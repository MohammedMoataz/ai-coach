{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"", "statusMessage": "Loading your memory brief..." }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt.js\"", "timeout": 20, "statusMessage": "Recording session..." }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|WebFetch|Read|Write|Edit|NotebookEdit", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.js\"", "timeout": 10, "statusMessage": "Scanning for secrets..." }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|Bash", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/observe.js\"", "statusMessage": "Recording observation..." }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/seed-refresh.js\"", "timeout": 15, "statusMessage": "Refreshing team seed..." }] },
      { "matcher": "WebFetch|WebSearch|Read", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/spotlight.js\"", "timeout": 10, "statusMessage": "Checking fetched content..." }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Edit|Write|Bash", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/observe.js\"", "statusMessage": "Recording failure..." }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notice.js\"", "timeout": 10, "statusMessage": "Noting what went wrong..." }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/seed-refresh.js\"", "timeout": 15, "statusMessage": "Refreshing team seed..." }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.js\"", "timeout": 60, "statusMessage": "Distilling session learnings..." }] }
    ]
  }
}
